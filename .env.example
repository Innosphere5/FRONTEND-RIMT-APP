EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
# Set an unsigned preset or configure the server-side signer URL (recommended).
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
EXPO_PUBLIC_CLOUDINARY_SIGNING_URL=https://your-admin-portal.example.com/api/cloudinary/sign

# Gemini API Keys for Resume Detection Engine
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
EXPO_PUBLIC_GEMINI_API_KEY_FALLBACK=your_fallback_gemini_api_key_here
